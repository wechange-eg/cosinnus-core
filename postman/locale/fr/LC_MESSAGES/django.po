msgstr "message en attente"

msgid "pending messages"
msgstr "messages en attente"

msgid "read at"
msgstr "lu le"

msgid "recipient"
msgstr "destinataire"

msgid "rejection reason"
msgstr "motif de rejet"

msgid "replied at"
msgstr "répondu le"

msgid "root message"
msgstr "message racine"

msgid "sender"
msgstr "expéditeur"

msgid "sent at"
msgstr "envoyé le"

msgid "status"
msgstr "état"

msgid "subject"
msgstr "objet"

msgid "visitor"
msgstr "visiteur"

