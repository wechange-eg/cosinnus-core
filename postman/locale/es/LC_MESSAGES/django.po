#, python-brace-format
msgid ""
"\n"
"\n"
"{sender} wrote:\n"
"{body}\n"
msgstr ""
"\n"
"\n"
"{sender} scribió:\n"
"{body}\n"

msgid ", for the following reason:"
msgstr ", por las siguientes razones:"

msgid ":"
msgstr " :"

msgid "<me>"
msgstr "<usuario>"

msgid "> "
msgstr "> "

msgid "Accept"
msgstr "Aceptar"

msgid "Accepted"
msgstr "Aceptado"

msgid "Action"
msgstr "Acción"

msgid "Additional recipient"
msgstr "Destinatario adicional"

msgid "Additional recipients"
msgstr "Destinatarios adicionales"

msgid "Archive"
msgstr "Archivar"

msgid "Archived Messages"
msgstr "Mensajes archivados"

msgid "Archives"
msgstr "Archivos"

msgid "As a reminder, please find below the content of your message."
msgstr "Como recordatorio, se adjunta a continuación el contenido de su mensaje."

msgid "Back"
msgstr "Volver"

msgid "Conversation"
msgstr "Conversación"

msgid "Date"
msgstr "Fecha"

msgid "Dates"
msgstr "Fechas"

msgid "Dear user,"
msgstr "Estimado usuario,"

msgid "Dear visitor,"
msgstr "Estimado visitante,"

msgid "Delete"
msgstr "Eliminar"

msgid "Deleted Messages"
msgstr "Mensajes eliminados"

msgid "Deletion date by recipient must be later than sending date."
msgstr "Fecha de eliminación por el destinatario debe ser posterior a la fecha de envío."

msgid "Deletion date by sender must be later than sending date."
msgstr "Fecha de eliminación por el remitente debe ser posterior a la fecha de envío."

msgid "Direct Reply Hash"
msgstr ""

msgid "Email"
msgstr "Correo"

#, python-brace-format
msgid "Ensure this value has at least {limit_value} distinct items (it has {show_value})."
msgstr "Asegúrese de que este valor tiene por lo menos {limit_value} elementos distintos (este tiene {show_value})."

#, python-brace-format
msgid "Ensure this value has at most {limit_value} distinct items (it has {show_value})."
msgstr "Asegúrese de que este valor tiene mas de {limit_value} elementos distintos (este tiene {show_value})."

msgid "For more comfort, we encourage you to open an account on the site."
msgstr "Para mayor comodidad, le recomendamos que abra una cuenta en el sitio."

msgid "Inbox"
msgstr "Recibidos"

msgid "Message"
msgstr "Mensaje"

#, python-format
msgid "Message \"%(subject)s\" on the site %(sitename)s"
msgstr "Mensaje \"%(subject)s\" en el sitio %(sitename)s"

msgid "Message Received"
msgstr "Mensaje recibido"

msgid "Message Rejected"
msgstr "Mensaje rechazado"

msgid "Message rejected for at least one recipient."
msgstr "Mensaje rechazado por al menos un destinatario."

msgid "Message successfully sent."
msgstr "Mensaje enviado con éxito."

msgid "Messages in this folder can be removed from time to time. For long term storage, use instead the archive folder."
msgstr "Los mensajes en esta carpeta pueden ser borrados de tanto en tanto. No utilice esta carpeta para almacenamiento a largo plazo."

msgid "Messages in this folder will never be removed. You can use this folder for long term storage."
msgstr "Los mensajes en esta carpeta no serán eliminados. Puede utilizar esta carpeta para el almacenamiento a largo plazo."

msgid "Messages or conversations successfully archived."
msgstr "Mensajes o conversaciones archivados con éxito."

msgid "Messages or conversations successfully deleted."
msgstr "Mensajes o conversaciones eliminados con éxito."

msgid "Messages or conversations successfully recovered."
msgstr "Mensajes o conversaciones recuperados con éxito."

msgid "Messaging"
msgstr "Mensajería"

msgid "Moderation"
msgstr "Moderación"

msgid "No messages."
msgstr "No hay mensajes."

msgid ""
"Note: This message is issued by an automated system.\n"
"Do not reply, this would not be taken into account."
msgstr "Nota: Este mensaje es emitido de forma automática. No responda, no se tendrán en cuenta."

#, python-format
msgid "On %(date)s, you asked to send a message to the user '%(recipient)s'."
msgstr "En la fecha %(date)s, solicitaste que se envíe un mensaje al usuario '%(recipient)s'."

#, python-format
msgid "On %(date)s, you sent a message to the user '%(sender)s'."
msgstr "En la fecha %(date)s, enviaste un mensaje al usuario '%(sender)s'."

msgid "Only Administrators may send a message to this project/group!"
msgstr ""

msgid "Pending"
msgstr "Pendiente"

msgid "Please correct the error below."
msgid_plural "Please correct the errors below."
msgstr[0] "Por favor, corrija el siguiente error."
msgstr[1] "Por favor, corrija los siguientes errores."

msgid "Please find below the answer from your correspondent."
msgstr "A continuación encontrará la respuesta de su interlocutor."

#, python-brace-format
msgid "Re: {subject}"
msgstr "Re: {subject}"

msgid "Reading date must be later than sending date."
msgstr "Fecha de lectura debe ser posterior a la fecha de envío."

msgid "Received"
msgstr "Recibido"

msgid "Received Messages"
msgstr "Mensajes recibidos"

msgid "Recipient"
msgstr "Destinatario"

msgid "Recipients"
msgstr "Destinatarios"

msgid "Reject"
msgstr "Rechazar"

msgid "Rejected"
msgstr "Rechazado"

msgid "Reply"
msgstr "Responder"

msgid "Reply Received"
msgstr "Respuesta recibida"

msgid "Response date cannot be set without at least one reply."
msgstr "Fecha de respuesta no se puede establecer sin al menos una respuesta."

msgid "Response date must be later than reading date."
msgstr "Fecha de respuesta debe ser posterior a la fecha de lectura."

msgid "Response date must be later than sending date."
msgstr "Fecha de respuesta debe ser posterior a la fecha de envío."

msgid "Select at least one object."
msgstr "Seleccione al menos un objeto."

msgid "Send"
msgstr "Enviar"

msgid "Sender"
msgstr "Emisor"

msgid "Sender and Recipient cannot be both undefined."
msgstr "Remitente y el destinatario no puede ser indefinido."

msgid "Sent"
msgstr "Enviado"

msgid "Sent Messages"
msgstr "Mensajes enviados"

#, python-brace-format
msgid "Some usernames are rejected: {users}."
msgstr "Algunos usuarios son rechazados: {users}."

#, python-brace-format
msgid "Some usernames are unknown or no longer active: {users}."
msgstr "Algunos usuarios son desconocidos o no están activos: {users}."

msgid "Sorry, this page number is invalid."
msgstr "Lo sentimos, este número de la página no es válida."

msgid "Subject"
msgstr "Asunto"

msgid "Thank you again for your interest in our services."
msgstr "Gracias de nuevo por su interés en nuestros servicios."

msgid "The message cannot be replied without being in a conversation."
msgstr "El mensaje no puede ser respondido sin estar en una conversación."

msgid "The message cannot be replied without having been read."
msgstr "El mensaje no puede ser respondido sin haberlo leído."

msgid "The site administrator"
msgstr "El administrador del sitio"

msgid "Trash"
msgstr "Papelera"

msgid "Undefined recipient."
msgstr "Destinatario no definido."

msgid "Undefined sender."
msgstr "Remitente no definido."

msgid "Undelete"
msgstr "Recuperar"

msgid "Visitor's email is in excess."
msgstr "Correo del visitante esta en exceso."

msgid "Visitor's email is missing."
msgstr "Correo del visitante no se encuentra."

msgid "Write"
msgstr "Escribe"

#, python-brace-format
msgid "Writing to some users is not possible: {users}."
msgstr "La escritura a algunos usuarios no es posible: {users}."

#, python-format
msgid "You have received a copy of a response from the user '%(sender)s'."
msgstr "Usted ha recibido una copia de una respuesta del usuario '%(sender)s'."

msgid "You have received a message"
msgstr "Ha recibido un mensaje"

#, python-format
msgid "You have received a message from the user '%(sender)s'."
msgstr "Ha recibido un mensaje de el usuario '%(sender)s'."

msgid "You have received a reply"
msgstr "Ha recibido una respuesta"

msgid "Your correspondent has given you an answer."
msgstr "Su interlocutor le ha dado una respuesta."

msgid "Your message has been rejected"
msgstr "Tu mensaje ha sido rechazada"

msgid "Your message has been rejected by the moderator"
msgstr "Tu mensaje ha sido rechazado por el moderador"

msgid "archived by recipient"
msgstr "archivado por el destinatario"

msgid "archived by sender"
msgstr "archivado por el remitente"

msgid "body"
msgstr "contenido"

msgid "by conversation"
msgstr "por conversación"

msgid "by message"
msgstr "por mensaje"

msgid "deleted by recipient at"
msgstr "eliminado por el destinatario el"

msgid "deleted by sender at"
msgstr "eliminado por el remitente el"

msgid "g:i A,M j,n/j/y"
msgstr "G:i,j b,j/n/y"

msgid "message"
msgstr "mensaje"

msgid "messages"
msgstr "mensajes"

msgid "moderated at"
msgstr "moderado el"

msgid "moderator"
msgstr "moderador"

msgid "parent message"
msgstr "mensaje padre"

msgid "pending message"
msgstr "mensaje pendiente"

msgid "pending messages"
msgstr "mensajes pendientes"

msgid "read at"
msgstr "leído a"

msgid "recipient"
msgstr "destinatario"

msgid "rejection reason"
msgstr "motivo de rechazo"

msgid "replied at"
msgstr "respondido a"

msgid "root message"
msgstr "mensaje raíz"

msgid "sender"
msgstr "emisor"

msgid "sent at"
msgstr "enviado a"

msgid "status"
msgstr "estado"

msgid "subject"
msgstr "asunto"

msgid "visitor"
msgstr "visitante"

