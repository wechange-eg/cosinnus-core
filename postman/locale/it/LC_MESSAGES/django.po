#, python-brace-format
msgid ""
"\n"
"\n"
"{sender} wrote:\n"
"{body}\n"
msgstr ""
"\n"
"\n"
"{sender} ha scritto:\n"
"{body}\n"

msgid ", for the following reason:"
msgstr ", per i seguenti motivi:"

msgid ":"
msgstr " :"

