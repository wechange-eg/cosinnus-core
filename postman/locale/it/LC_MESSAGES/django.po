msgstr "Accettare"

msgid "Accepted"
msgstr "Accettato"

msgid "Action"
msgstr "Azione"

msgid "Additional recipient"
msgstr "Destinatario aggiunto"

msgid "Additional recipients"
msgstr "Destinatari aggiunti"

msgid "Archive"
msgstr "Archiviare"

msgid "Archived Messages"
msgstr "Messaggi archiviati"

msgid "Archives"
msgstr "Archivi"

msgid "As a reminder, please find below the content of your message."
msgstr "Come promemoria, puoi trovare qui di seguito il contenuto del messaggio."

msgid "Back"
msgstr "Indietro"

msgid "Conversation"
msgstr "Conversazione"

msgid "Date"
msgstr "Data"

msgid "Dates"
msgstr "Date"

msgid "Dear user,"
msgstr "Caro utente,"

msgid "Dear visitor,"
msgstr "Caro visitatore,"

msgid "Delete"
msgstr "Eliminare"

msgid "Deleted Messages"
msgstr "Messaggi eliminati"

msgid "Deletion date by recipient must be later than sending date."
msgstr ""

msgid "Deletion date by sender must be later than sending date."
msgstr ""

msgid "Direct Reply Hash"
msgstr ""

msgid "Email"
msgstr "Posta"

#, python-brace-format
msgid "Ensure this value has at least {limit_value} distinct items (it has {show_value})."
msgstr "Assicurarsi che questo valore abbia almeno {limit_value} elementi distinti (ora ne ha {show_value})."

#, python-brace-format
msgid "Ensure this value has at most {limit_value} distinct items (it has {show_value})."
msgstr "Assicurarsi che questo valore abbia al massimo {limit_value} elementi distinti (ora ne ha {show_value})."

msgid "For more comfort, we encourage you to open an account on the site."
msgstr "Per un maggior comfort, ti invitiamo ad aprire un account sul sito."

msgid "Inbox"
msgstr "Posta in arrivo"

msgid "Message"
msgstr "Messaggio"

#, python-format
msgid "Message \"%(subject)s\" on the site %(sitename)s"
msgstr "Messaggio \"%(subject)s\" sul sito %(sitename)s"

msgid "Message Received"
msgstr "Messaggio ricevuto"

msgid "Message Rejected"
msgstr "Messaggio rifiutato"

msgid "Message rejected for at least one recipient."
msgstr "Messaggio rifiutato per almeno un destinatario."

msgid "Message successfully sent."
msgstr "Messaggio inviato con successo."

msgid "Messages in this folder can be removed from time to time. For long term storage, use instead the archive folder."
msgstr "I messaggi in questa cartella possono essere rimossi di volta in volta. Per la conservazione a lungo termine, utilizzare invece la cartella di archivio."

msgid "Messages in this folder will never be removed. You can use this folder for long term storage."
msgstr "I messaggi in questa cartella non saranno mai rimossi. È possibile utilizzare questa cartella per archiviarli."

msgid "Messages or conversations successfully archived."
msgstr "Messaggi o conversazioni archiviati con successo."

msgid "Messages or conversations successfully deleted."
msgstr "Messaggi o conversazioni eliminati con successo."

msgid "Messages or conversations successfully recovered."
msgstr "Messaggi o conversazioni recuperati con successo."

msgid "Messaging"
msgstr "Scrivendo"

msgid "Moderation"
msgstr ""

msgid "No messages."
msgstr "Nessun messaggio."

msgid ""
"Note: This message is issued by an automated system.\n"
"Do not reply, this would not be taken into account."
msgstr ""
"Nota: Questo messaggio è inviato da un sistema automatico.\n"
"Non rispondere, non sarebbe preso in considerazione."

#, python-format
msgid "On %(date)s, you asked to send a message to the user '%(recipient)s'."
msgstr "Il %(date)s, hai chiesto di inviare un messaggio all'utente '%(recipient)s'."

#, python-format
msgid "On %(date)s, you sent a message to the user '%(sender)s'."
msgstr "Il %(date)s, hai inviato un messaggio all'utente '%(sender)s'."

msgid "Only Administrators may send a message to this project/group!"
msgstr ""

msgid "Pending"
msgstr "In attesa"

msgid "Please correct the error below."
msgid_plural "Please correct the errors below."
msgstr[0] "Correggi l'errore qui sotto."
msgstr[1] "Correggi gli errori qui sotto."

msgid "Please find below the answer from your correspondent."
msgstr "Qui di seguito troverai la risposta dal tuo corrispondente."

#, python-brace-format
msgid "Re: {subject}"
msgstr "Re: {subject}"

msgid "Reading date must be later than sending date."
msgstr "La data di lettura deve essere successiva alla data di invio."

msgid "Received"
msgstr "Ricevuto"

msgid "Received Messages"
msgstr "Messaggi ricevuti"

msgid "Recipient"
msgstr "Destinatario"

msgid "Recipients"
msgstr "Destinatari"

msgid "Reject"
msgstr "Rifiutare"

msgid "Rejected"
msgstr "Rifiutato"

msgid "Reply"
msgstr "Rispondi"

msgid "Reply Received"
msgstr "Risposta ricevuta"

msgid "Response date cannot be set without at least one reply."
msgstr "La data di risposta non può essere impostata senza almeno una risposta."

msgid "Response date must be later than reading date."
msgstr "La data di risposta deve essere successiva alla data di lettura."

msgid "Response date must be later than sending date."
msgstr "La data di risposta deve essere successiva alla data di invio."

msgid "Select at least one object."
msgstr "Selezionare almeno un oggetto."

msgid "Send"
msgstr "Invia"

msgid "Sender"
msgstr "Mittente"

msgid "Sender and Recipient cannot be both undefined."
msgstr ""

msgid "Sent"
msgstr "Spedito"

msgid "Sent Messages"
msgstr "Messaggi inviati"

#, python-brace-format
msgid "Some usernames are rejected: {users}."
msgstr "Alcuni utenti sono stati rifiutati: {users}."

#, python-brace-format
msgid "Some usernames are unknown or no longer active: {users}."
msgstr "Alcuni utenti sono sconosciuti o non attivi: {users}."

msgid "Sorry, this page number is invalid."
msgstr "Spiacenti, questo numero di pagina non è valido."

msgid "Subject"
msgstr "Soggetto"

msgid "Thank you again for your interest in our services."
msgstr "Grazie per il tuo interesse nei nostri servizi."

msgid "The message cannot be replied without being in a conversation."
msgstr ""

msgid "The message cannot be replied without having been read."
msgstr "È impossibile rispondere al messaggio se non è stato letto."

msgid "The site administrator"
msgstr "L'amministratore del sito"

msgid "Trash"
msgstr "Cestino"

msgid "Undefined recipient."
msgstr "Destinatario non specificato."

msgid "Undefined sender."
msgstr "Mittente non definito."

msgid "Undelete"
msgstr "Ripristinare"

msgid "Visitor's email is in excess."
msgstr "La mail del visitatore è piena."

msgid "Visitor's email is missing."
msgstr "Manca la mail del visitatore."

msgid "Write"
msgstr "Scrivi"

#, python-brace-format
msgid "Writing to some users is not possible: {users}."
msgstr "Non è possibile scrivere ad alcuni utenti: {users}."

#, python-format
msgid "You have received a copy of a response from the user '%(sender)s'."
msgstr "Hai ricevuto la copia della risposta dall'utente '%(sender)s'."

msgid "You have received a message"
msgstr "Hai ricevuto un messaggio"

#, python-format
msgid "You have received a message from the user '%(sender)s'."
msgstr "Hai ricevuto un messaggio dall'utente '%(sender)s'."

msgid "You have received a reply"
msgstr "Hai ricevuto una risposta"

msgid "Your correspondent has given you an answer."
msgstr "Il tuo interlocutore ti ha dato una risposta."

msgid "Your message has been rejected"
msgstr "Il tuo messaggio è stato respinto"

msgid "Your message has been rejected by the moderator"
msgstr "Il tuo messaggio è stato rifiutato dal moderatore"

