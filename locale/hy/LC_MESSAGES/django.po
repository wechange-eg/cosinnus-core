msgid "We could not obtain access to the Fan-Page for your connected Facebook Account. Please check that you entered the correct Fan-Page name, and that you are an Editor of that Fan-Page!"
msgstr "Մենք չկարողացանք մուտք գործել Fan-էջ ձեր միացված Facebook -ի էջի համար: Խնդրում ենք ստուգել, որ դուք մուտքագրել եք Fan-էջի ճիշտ անունը, և որ դուք հանդիսանում եք այդ Fan-էջի խմբագիրը!"

msgid "We could not post this news post on the Facebook Group/Fan-Page. If this problem persists, please try disconnecting and re-connecting your Facebook account and make sure you allow us to post with a visibility of at least \"Friends\". If you are trying to post as a Fan-Page, make sure you accept the necessary permissions for us to post there, and make sure you are an Editor of the Fan-Page! If this doesn't work, contact this project/group's administrator!"
msgstr "Մենք չկարողացանք հրապարակել այս լուրը Facebook-ի խմբում/Fan-էջում: Եթե այս խնդիրը շարունակում է հայտնվել, խնդրում ենք փորձեք անջատել և նորից միացնել ձեր Facebook-ի էջին և համոզվել, որ թույլ եք տալիս մեզ գրառում տեղադրել առնվազն «Ընկերների» տեսանելիությամբ: Եթե փորձում եք հրապարակել որպես Fan-էջ, համոզվեք, որ ընդունում եք մեզ համար անհրաժեշտ թույլտվությունները `այնտեղ հրապարակելու համար, և համոզվեք, որ դուք Fan-էջի խմբագիրն եք: Եթե դա ևս ձախողվեց, դիմեք այս ծրագրի/խմբի ադմինիստրատորին!"

msgid "We could not post this news post on your Facebook timeline. If this problem persists, please make sure you have granted us all required Facebook permissions, or try disconnecting and re-connecting your Facebook account!"
msgstr "Մենք չկարողացանք տեղադրել այս նորությունների գրառումը ձեր Facebook-ի նորությունների հոսքում: Եթե այս խնդիրը շարունակում է հայտնվել, խնդրում ենք համոզվեք, որ մեզ տվել եք բոլոր անհրաժեշտ Facebook-ի թույլտվությունները, կամ փորձեք անջատել և նորից միացնել ձեր Facebook- ի անձնական էջը!"

msgid "We could not retrieve your groups from Facebook because of an error. Please contact an administrator!"
msgstr "Սխալի պատճառով չկարողացանք ձեր խմբերը առբերել Facebook- ից: Խնդրում ենք դիմել ադմինիստրատորին!"

