msgstr "Օգտատեր"

#, python-format
msgid ""
"User \"%(sender_name)s\" has accepted the invitation to join \"%(team_name)s\".\n"
"\n"
"You're receiving this email because you are an administrator of this team.\n"
"\n"
"(Follow this link to edit your notification preferences: %(notification_settings_url)s )\n"
"\n"
"\n"
"Your %(site_name)s Team"
msgstr ""
"\"%(sender_name)s\" օգտատերը ընդունել է \"%(team_name)s\" -ին միանալու հրավերը.\n"
"\n"
"Դուք ստանում եք այս էլ. նամակը, քանի որ այս թիմի ադմինիստրատորն եք.\n"
"\n"
"(Անցեք այս հղումով ՝ ձեր ծանուցման նախապատվությունները խմբագրելու համար: %(notification_settings_url)s )\n"
"\n"
"\n"
"Ձեր %(site_name)s թիմ"

#, python-format
msgid ""
"User \"%(sender_name)s\" has declined the invitation to join \"%(team_name)s\".\n"
"\n"
"You're receiving this email because you are an administrator of this team.\n"
"\n"
"(Follow this link to edit your notification preferences: %(notification_settings_url)s )\n"
"\n"
"\n"
"Your %(site_name)s Team"
msgstr ""
"\"%(sender_name)s\" օգտատերը մերժել է \"%(team_name)s\" -ին միանալու հրավերը.\n"
"\n"
"Դուք ստանում եք այս էլ. նամակը, քանի որ այս թիմի ադմինիստրատորն եք.\n"
"\n"
"(Անցեք այս հղումով ՝ ձեր ծանուցման նախապատվությունները խմբագրելու համար: %(notification_settings_url)s )\n"
"\n"
"\n"
"Ձեր %(site_name)s թիմ"

#, python-format
msgid ""
"User \"%(sender_name)s\" has reported the item \"%(object_name)s\" to be offensive.\n"
"\n"
"The reason, as written by the reporter:\n"
"\"%(report_text)s\"\n"
"\n"
"\n"
"You can view the item in question here:\n"
"%(object_url)s\n"
"\n"
"Please go to the following page to respond to the report:\n"
"%(domain_url)s%(report_admin_url)s\n"
"\n"
"\n"
"(You're receiving this email because you are an administrator of this portal.)\n"
"\n"
"\n"
"Your %(site_name)s Team"
msgstr ""
"\"%(sender_name)s\" օգտատերը հայտնել է վիրավորական նյութի \"%(object_name)s\" մասին.\n"
"\n"
"Պատճառը, ինչպես գրել է զեկուցողը՝\n"
"\"%(report_text)s\"\n"
"\n"
"\n"
"Դուք կարող եք դիտել հայցվող նյութը այստեղ։\n"
"%(object_url)s\n"
"\n"
"Խնդրում ենք անցնել հետևյալ էջ ՝ զեկույցին պատասխանելու համար:\n"
"%(domain_url)s%(report_admin_url)s\n"
"\n"
"\n"
"(Դուք ստանում եք այս էլ. նամակը, քանի որ այս պորտալի ադմինիստրատորն եք):\n"
"\n"
"\n"
"Ձեր %(site_name)s թիմ"

#, python-format
msgid ""
"User \"%(sender_name)s\" has requested to join %(team_name)s.\n"
"\n"
"Please go to the following page to accept or decline the request:\n"
"%(domain_url)s%(group_page_url)s\n"
"\n"
"You're receiving this email because you are an administrator of this team.\n"
"\n"
"(Follow this link to edit your notification preferences: %(notification_settings_url)s )\n"
"\n"
"\n"
"Your %(site_name)s Team"
msgstr ""
"\"%(sender_name)s\" օգտատերը հարցում է ուղարկել միանալ %(team_name)s -ին.\n"
"\n"
"Խնդրում ենք անցնել հետևյալ էջ՝ հարցումն ընդունել կամ մերժելու համար:\n"
"%(domain_url)s%(group_page_url)s\n"
"\n"
"Դուք ստանում եք այս էլ. նամակը, քանի որ թիմի ադմինիստրատորն եք.\n"
"\n"
"(Անցեք այս հղումով ՝ ձեր ծանուցման նախապատվությունները խմբագրելու համար: %(notification_settings_url)s )\n"
"\n"
"\n"
"Ձեր %(site_name)s թիմ"

